SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=1
ALLOWED_HOSTS=*
POSTGRES_DB=ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
# Celery: run tasks inline (no worker/redis needed) for local demos
CELERY_EAGER=0
# Mock payment provider
PROVIDER_WEBHOOK_SECRET=whsec_dev_secret
PROVIDER_WEBHOOK_URL=http://localhost:8000/api/webhooks/provider/
# Fees (basis points; min/max in minor units, 0 = no cap)
TRANSFER_FEE_BPS=50
TRANSFER_FEE_MIN=0
TRANSFER_FEE_MAX=0
# Auth & throttling
JWT_ACCESS_MINUTES=15
THROTTLE_ANON=30/min
THROTTLE_USER=600/min
THROTTLE_MONEY=120/min
# Observability
LOG_FORMAT=json
LOG_LEVEL=INFO
OTEL_ENABLED=0
OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
